generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Profil aplikasi yang berelasi 1:1 dengan auth.users Supabase.
/// Role ditetapkan lewat backend tepercaya, tidak pernah dari body request client.
model Profile {
  id                  String          @id
  fullName            String
  /// Nama panggilan singkat yang tampil di samping nama lengkap.
  nickname            String?
  /// Username unik untuk identitas di kelas (tanpa spasi).
  username            String?         @unique
  role                Role            @default(STUDENT)
  className           String?
  avatarUrl           String?
  isActive            Boolean         @default(true)
  lastActive          DateTime        @default(now())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  isLocked            Boolean         @default(false)
  auditLog            AuditLog[]
  coursesOwned        Course[]        @relation("CourseOwner")
  enrollments         Enrollment[]
  gameAttempts        GameAttempt[]
  gameVersionsCreated GameVersion[]
  notifications       Notification[]
  progress            Progress[]
  quizAttempts        QuizAttempt[]
  avatarAssignments   StudentAvatar[]
  submissions         Submission[]
  groupMemberships    GroupRoomMember[]

  @@index([role])
  @@index([className])
}

/// Riwayat avatar siswa (mendukung ubah avatar + pilihan koleksi).
model StudentAvatar {
  id        String   @id @default(cuid())
  studentId String
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  student   Profile  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Course {
  id              String         @id @default(cuid())
  slug            String         @unique
  /// Token unik untuk link join; divalidasi di server, bukan cuma judul.
  joinToken       String         @unique @default(cuid())
  title           String
  shortTitle      String
  description     String
  subject         String
  grade           String
  duration        String         @default("1 JP")
  state           CourseState    @default(DRAFT)
  access          AccessState    @default(OPEN)
  /// Guru pemilik. Otorisasi selalu merujuk relasi ini.
  ownerId         String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  /// Draft: setiap suntingan guru menulis ke tabel materi + menandai waktu ini.
  draftUpdatedAt  DateTime?
  /// Dokumen modul ajar (PDF/PPT/DOCX) yang hanya dikelola & dilihat guru.
  moduleDocFileId String?
  moduleDocMime   String?
  moduleDocName   String?
  /// Waktu versi terakhir dipublikasikan ke siswa.
  publishedAt     DateTime?
  owner           Profile        @relation("CourseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  publish         CoursePublish?
  enrollments     Enrollment[]
  gameAttempts    GameAttempt[]
  gameVersions    GameVersion[]
  modules         Module[]
  progress        Progress[]
  quizAttempts    QuizAttempt[]
  submissions     Submission[]
  meetings        Meeting[]
  collaborations  Collaboration[]
  groupRooms      GroupRoom[]

  @@index([ownerId])
  @@index([state])
}

/// Snapshot materi yang sedang terlihat siswa. Disimpan saat guru menekan
/// Publish dari data draft di tabel Module/LessonBlock/Quiz.
model CoursePublish {
  id          String   @id @default(cuid())
  courseId    String   @unique
  payload     Json
  publishedAt DateTime @default(now())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([publishedAt])
}

model Module {
  id        String        @id @default(cuid())
  courseId  String
  title     String
  eyebrow   String        @default("")
  accent    String        @default("violet")
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  /// Estimasi waktu tampil terpisah dari eyebrow agar format rapi.
  duration  String        @default("10 menit")
  blocks    LessonBlock[]
  meetings  Meeting[]
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model LessonBlock {
  id           String        @id @default(cuid())
  moduleId     String
  type         BlockType
  title        String
  description  String        @default("")
  duration     String        @default("5 menit")
  order        Int           @default(0)
  /// Materi fleksibel: text, videoUrl, pdfUrl, config game/kuis/aktivitas.
  material     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  gameAttempts GameAttempt[]
  module       Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress     Progress[]
  quiz         Quiz?
  quizAttempts QuizAttempt[]
  submissions  Submission[]

  @@index([moduleId])
}

/// Link kolaborasi (Zoom/Meet/Classroom/Teams) untuk satu pertemuan.
/// Satu pertemuan menyimpan paling banyak satu link per penyedia.
model Meeting {
  id        String   @id @default(cuid())
  courseId  String
  moduleId  String
  provider  String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, provider])
  @@index([courseId])
  @@index([moduleId])
}

/// Kolaborasi kelas di luar pertemuan: satu judul, deskripsi, banyak link.
/// Contoh: "Kolaborasi PhET" berisi tiga tautan simulasi garis bilangan.
model Collaboration {
  id          String              @id @default(cuid())
  courseId    String
  title       String
  description String              @default("")
  order       Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  course      Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  links       CollaborationLink[]

  @@index([courseId])
}

model CollaborationLink {
  id              String        @id @default(cuid())
  collaborationId String
  label           String
  url             String
  /// Provider terdeteksi (zoom, meet, polypad, geogebra, phet) atau "link".
  provider        String        @default("link")
  order           Int           @default(0)
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@index([collaborationId])
}

/// Room tugas kelompok. Privat: hanya anggota (join dengan kode) dan guru pemilik
/// course yang bisa membaca chat serta tugasnya.
model GroupRoom {
  id           String            @id @default(cuid())
  courseId     String
  name         String
  instructions String            @default("")
  maxMembers   Int               @default(5)
  deadline     DateTime?
  grade        Int?
  feedback     String?
  gradedAt     DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  course       Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  members      GroupRoomMember[]
  messages     GroupMessage[]
  tasks        GroupTask[]

  @@index([courseId])
}

model GroupRoomMember {
  id        String    @id @default(cuid())
  roomId    String
  studentId String
  joinedAt  DateTime  @default(now())
  room      GroupRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student   Profile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([roomId, studentId])
  @@index([studentId])
}

model GroupMessage {
  id         String    @id @default(cuid())
  roomId     String
  authorId   String
  authorName String
  body       String
  createdAt  DateTime  @default(now())
  room       GroupRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

/// Tugas yang dikerjakan bersama. Semua anggota boleh menambah, mengedit, dan
/// menghapus selama room belum dinilai dan deadline belum lewat.
model GroupTask {
  id            String    @id @default(cuid())
  roomId        String
  title         String
  body          String    @default("")
  fileUrl       String?
  fileName      String?
  createdById   String
  createdByName String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  room          GroupRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

/// Hubungan siswa↔pembelajaran. Unique constraint mencegah enrollment ganda.
model Enrollment {
  id        String           @id @default(cuid())
  studentId String
  courseId  String
  status    EnrollmentStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   Profile          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([studentId])
}

/// Progres satu blok oleh satu siswa. Idempoten lewat unique(studentId, blockId).
model Progress {
  id          String      @id @default(cuid())
  studentId   String
  courseId    String
  blockId     String
  completed   Boolean     @default(false)
  completedAt DateTime?
  /// Idempotency key dari client untuk mencegah duplikasi saat retry.
  eventId     String?     @unique
  updatedAt   DateTime    @updatedAt
  block       LessonBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student     Profile     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, blockId])
  @@index([courseId])
  @@index([studentId])
}

model Quiz {
  id            String      @id @default(cuid())
  blockId       String      @unique
  title         String
  instructions  String      @default("")
  totalPoints   Int         @default(100)
  maxAttempts   Int         @default(2)
  shuffle       Boolean     @default(false)
  passThreshold Int         @default(70)
  showScore     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  questions     Question[]
  block         LessonBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
}

model Question {
  id          String       @id @default(cuid())
  quizId      String
  type        QuestionType @default(MULTIPLE_CHOICE)
  prompt      String
  options     Json?
  answer      String
  explanation String       @default("")
  points      Int          @default(10)
  order       Int          @default(0)
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAttempt {
  id            String      @id @default(cuid())
  studentId     String
  courseId      String
  blockId       String
  attemptNumber Int
  score         Int
  totalPoints   Int
  passed        Boolean     @default(false)
  /// Jawaban per soal (JSON) untuk analitik salah/jawaban.
  answers       Json?
  /// Idempotency key mencegah attempt ganda saat retry.
  eventId       String?     @unique
  submittedAt   DateTime    @default(now())
  block         LessonBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  course        Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student       Profile     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, blockId, attemptNumber])
  @@index([courseId])
  @@index([studentId])
}

/// Tugas/aktivitas uraian yang dinilai manual guru.
model Submission {
  id          String           @id @default(cuid())
  studentId   String
  courseId    String
  blockId     String
  response    String           @default("")
  fileUrl     String?
  score       Int?
  maxScore    Int              @default(100)
  feedback    String?
  status      SubmissionStatus @default(SUBMITTED)
  eventId     String?          @unique
  submittedAt DateTime         @default(now())
  reviewedAt  DateTime?
  fileName    String?
  fileType    String?
  block       LessonBlock      @relation(fields: [blockId], references: [id], onDelete: Cascade)
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student     Profile          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([studentId])
  @@index([blockId])
}

model GameVersion {
  id           String        @id @default(cuid())
  courseId     String?
  templateId   String
  name         String
  instructions String        @default("")
  /// Konfigurasi perilaku game; benar-benar mengubah mekanika.
  config       Json
  version      Int           @default(1)
  published    Boolean       @default(false)
  /// Draft disimpan terpisah dari versi terbit agar tidak merusak hasil peserta.
  isDraft      Boolean       @default(true)
  createdBy    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  attempts     GameAttempt[]
  course       Course?       @relation(fields: [courseId], references: [id])
  creator      Profile       @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([templateId])
}

model GameAttempt {
  id            String       @id @default(cuid())
  studentId     String
  courseId      String?
  blockId       String?
  gameVersionId String
  score         Int          @default(0)
  passed        Boolean      @default(false)
  /// Playtest guru TIDAK boleh mempengaruhi nilai/enrollment siswa.
  isPlaytest    Boolean      @default(false)
  details       Json?
  playedAt      DateTime     @default(now())
  block         LessonBlock? @relation(fields: [blockId], references: [id])
  course        Course?      @relation(fields: [courseId], references: [id])
  gameVersion   GameVersion  @relation(fields: [gameVersionId], references: [id], onDelete: Cascade)
  student       Profile      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseId])
  @@index([gameVersionId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Log tindakan administratif penting untuk ditinjau Admin.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())
  actor     Profile? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
}

/// Pengaturan platform (branding global) — satu baris singleton.
model PlatformSetting {
  id        String   @id @default("singleton")
  appName   String   @default("EduVerse")
  accent    String   @default("#7C5CFC")
  updatedAt DateTime @updatedAt
}

/// Berkas (PDF/gambar) yang diunggah guru atau siswa.
/// Disimpan di database agar materi & bukti jawaban tidak hilang saat browser ditutup.
model StoredFile {
  id        String   @id @default(cuid())
  ownerId   String?
  courseId  String?
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  /// Materi publik boleh dibaca peserta tanpa login; jawaban siswa tetap privat.
  isPublic  Boolean  @default(false)

  @@index([courseId])
  @@index([ownerId])
}

model ForumPost {
  id         String       @id @default(cuid())
  moduleId   String
  courseSlug String
  authorId   String
  authorName String
  role       String
  className  String?
  title      String
  content    String
  likes      Int          @default(0)
  createdAt  DateTime     @default(now())
  replies    ForumReply[]

  @@index([moduleId])
  @@index([courseSlug])
}

model ForumReply {
  id         String    @id @default(cuid())
  postId     String
  authorId   String
  authorName String
  role       String
  content    String
  likes      Int       @default(0)
  isVerified Boolean   @default(false)
  createdAt  DateTime  @default(now())
  post       ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum CourseState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AccessState {
  OPEN
  NEW_ENROLLMENT_CLOSED
  LOCKED
}

enum EnrollmentStatus {
  ACTIVE
  HIDDEN
  LEFT
}

enum BlockType {
  TEXT
  VIDEO
  ACTIVITY
  QUIZ
  ASSIGNMENT
  GAME
  REFLECTION
  LINK
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  NEEDS_REVISION
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  NUMBER
  ESSAY
  MATCHING
  ORDERING
  FILL_BLANK
  DRAG_DROP
}
